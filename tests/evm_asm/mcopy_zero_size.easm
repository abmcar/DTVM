// MCOPY with zero size keeps existing memory and skips source/destination access
PUSH1 0x2D
PUSH1 0x00
MSTORE
PUSH1 0x00
PUSH32 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
PUSH32 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
MCOPY
PUSH1 0x20
PUSH1 0x00
RETURN
