// EXTCODECOPY with zero size keeps existing memory and skips code copy work
PUSH1 0x2C
PUSH1 0x00
MSTORE
PUSH1 0x00
PUSH32 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
PUSH32 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
PUSH1 0x00
EXTCODECOPY
PUSH1 0x20
PUSH1 0x00
RETURN
